# Copy this file to .env in the project root. Keep .env private.
RCTF_URL=https://ctf.example.com
RCTF_CHALLENGE_ID=apex-gp
RCTF_INSTANCER=docker
RCTF_CLIENT_ID=REPLACE_ME_WITH_EXTERNAL_APP_UUID
RCTF_CLIENT_SECRET=REPLACE_ME_WITH_EXTERNAL_APP_SECRET
RCTF_SCORING_SECRET=REPLACE_ME_WITH_64_HEX_CHARACTERS
APEX_COOKIE_SECRET=REPLACE_ME_WITH_ANOTHER_64_HEX_CHARACTERS
APEX_GATEWAY_KEY=REPLACE_ME_WITH_ANOTHER_64_HEX_CHARACTERS

COORDINATOR_PUBLIC_URL=https://timing.example.com
COORDINATOR_HOST=timing.example.com
INSTANCE_DOMAIN=instances.example.com
INSTANCE_PREFIX=apex-gp-
APEX_IMAGE=ghcr.io/ashraful-notfound/apex-gp:ctf-v2

# Use explicit UTC dates matching the rCTF event. Configure before launch.
EVENT_ID=ductf-2026-apex-instance-races
EVENT_START=2026-11-01T00:00:00Z
EVENT_END=2026-11-02T00:00:00Z
EVENT_SEED=2026
MAX_SESSIONS=24
DATA_DIR=/var/lib/apex-gp
HOST=0.0.0.0
PORT=8081
